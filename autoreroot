# Set PATH to ensure all Termux commands are found
export PATH="/data/data/com.termux/files/usr/bin:$PATH"

# Directory where LineageOS puts OTA zips
OTA_DIR="/data/lineageos_updates"

# Log file
LOGFILE=~/auto_reroot.log

echo "=== Auto Reroot Started: $(date) ===" >> "$LOGFILE"

# Make sure su is available
if ! command -v su &> /dev/null; then
    echo "Error: su not found! Device must be rooted." | tee -a "$LOGFILE"
    echo "PATH is: $PATH" >> "$LOGFILE"
    exit 1
fi

# Check if OTA directory exists
if ! su -c "[ -d '$OTA_DIR' ]"; then
    echo "Error: OTA directory $OTA_DIR does not exist!" | tee -a "$LOGFILE"
    echo "Creating OTA directory..." | tee -a "$LOGFILE"
    if ! su -c "mkdir -p '$OTA_DIR'"; then
        echo "Failed to create OTA directory!" | tee -a "$LOGFILE"
        exit 1
    fi
    echo "OTA directory created successfully." | tee -a "$LOGFILE"
fi

# Check if inotifywait is available
if ! command -v inotifywait &> /dev/null; then
    echo "Error: inotifywait not found! Install inotify-tools in Termux." | tee -a "$LOGFILE"
    exit 1
fi

echo "Monitoring $OTA_DIR for OTA updates..." | tee -a "$LOGFILE"

# Monitor OTA directory for new files
su -c "inotifywait -m -e create --format '%f' '$OTA_DIR'" 2>&1 | while read -r FILENAME; do
    if [[ "$FILENAME" == *.zip ]]; then
        OTA_PATH="$OTA_DIR/$FILENAME"
        echo "New OTA detected: $OTA_PATH" | tee -a "$LOGFILE"

        # Optional: Toast notification (Termux API must be installed)
        command -v termux-toast &> /dev/null && termux-toast "New OTA detected. Starting reroot..."

        # Get active slot
        ACTIVE_SLOT=$(su -c "getprop ro.boot.slot_suffix")
        echo "Active slot: $ACTIVE_SLOT" | tee -a "$LOGFILE"

        # Check if Magisk can patch OTA
        if ! su -c "magisk --canota" >> "$LOGFILE" 2>&1; then
            echo "Magisk OTA patch not ready. Skipping." | tee -a "$LOGFILE"
            command -v termux-toast &> /dev/null && termux-toast "Magisk OTA not ready. Abort."
            continue
        fi

        # Patch inactive slot
        if ! su -c "magisk --install-to-inactive-slot" >> "$LOGFILE" 2>&1; then
            echo "Magisk patch failed!" | tee -a "$LOGFILE"
            command -v termux-toast &> /dev/null && termux-toast "Magisk patch failed!"
            continue
        fi

        echo "Magisk patched inactive slot. Rebooting..." | tee -a "$LOGFILE"
        command -v termux-toast &> /dev/null && termux-toast "Magisk patched! Rebooting..."

        # Reboot device
        su -c "reboot"
    fi
done
