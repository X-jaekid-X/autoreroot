export PATH="/data/data/com.termux/files/usr/bin:$PATH"

OTA_DIR="/data/lineageos_updates"
LOGFILE=~/auto_reroot.log
PROCESSED_FILE=~/.auto_reroot_processed

echo "=== Auto Reroot Started: $(date) ===" >> "$LOGFILE"

# Ensure su exists
if ! command -v su &> /dev/null; then
    echo "Error: su not found! Device must be rooted." >> "$LOGFILE"
    exit 1
fi

# Ensure OTA directory exists
if ! su -c "[ -d '$OTA_DIR' ]"; then
    echo "OTA dir missing, creating..." >> "$LOGFILE"
    su -c "mkdir -p '$OTA_DIR'"
fi

# Track processed OTAs
touch "$PROCESSED_FILE"

echo "Polling $OTA_DIR for OTA updates..." >> "$LOGFILE"

while true; do
    OTA_FILES=$(su -c "ls '$OTA_DIR'/*.zip 2>/dev/null" || true)

# No OTA files → skip silently
[ -z "$OTA_FILES" ] && sleep 10 && continue

# Loop over OTAs
while IFS= read -r OTA_PATH; do
    FILENAME=$(basename "$OTA_PATH")

    # Only notify if this is a NEW OTA
    if ! grep -q "^$FILENAME$" "$PROCESSED_FILE"; then
                echo "New OTA detected: $OTA_PATH" >> "$LOGFILE"
                echo "$FILENAME" >> "$PROCESSED_FILE"

                command -v termux-toast &> /dev/null && termux-toast "OTA detected. Patching..."

                ACTIVE_SLOT=$(su -c "getprop ro.boot.slot_suffix")
                echo "Active slot: $ACTIVE_SLOT" >> "$LOGFILE"

                # Verify Magisk exists
                if ! su -c "command -v magisk" &> /dev/null; then
                    echo "Magisk not found!" >> "$LOGFILE"
                    continue
                fi

                echo "Patching inactive slot..." >> "$LOGFILE"

                if ! su -c "magisk --install-to-inactive-slot" >> "$LOGFILE" 2>&1; then
                    echo "Magisk patch failed!" >> "$LOGFILE"
                    continue
                fi

                echo "Patch successful — rebooting in 5s" >> "$LOGFILE"
                sleep 5
                su -c reboot
            fi
        done <<< "$OTA_FILES"
    fi

    sleep 10
done
