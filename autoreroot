OTA_DIR="/data/lineageos_updates"
LOGFILE="$HOME/auto_reroot.log"

echo "=== Auto Reroot Started: $(date) ===" >> "$LOGFILE"

su -c "inotifywait -m -e create --format '%f' '$OTA_DIR'" | while read FILENAME
do
    if [[ "\$FILENAME" == *.zip ]]; then
        OTA_PATH=\"\$OTA_DIR/\$FILENAME\"
        echo \"New OTA detected: \$OTA_PATH\" | tee -a \"$LOGFILE\"

        # Optional Termux toast
        termux-toast \"New OTA detected. Starting reroot...\"

        # Get active slot
        ACTIVE_SLOT=\$(getprop ro.boot.slot_suffix)
        echo \"Active slot: \$ACTIVE_SLOT\" | tee -a \"$LOGFILE\"

        # Check if Magisk can patch OTA
        su -c "magisk --canota" 2>&1 | tee -a "$LOGFILE"
        if [ \$? -ne 0 ]; then
            termux-toast \"Magisk OTA not ready. Abort.\"
            echo \"Magisk OTA not ready. Abort.\" >> "$LOGFILE"
            continue
        fi

        # Patch inactive slot
        su -c "magisk --install-to-inactive-slot" 2>&1 | tee -a "$LOGFILE"
        if [ \$? -ne 0 ]; then
            termux-toast \"Magisk patch failed!\"
            echo \"Magisk patch failed!\" >> "$LOGFILE"
            continue
        fi

        termux-toast \"Magisk patched the OTA! Rebooting...\"
        echo \"Magisk patched the OTA! Rebooting...\" >> "$LOGFILE"

        # Reboot device
        su -c "reboot"
    fi
done
